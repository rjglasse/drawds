{
  "name": "drawds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sketch data structures (arrays, trees, graphs, maps) for teaching, on a tldraw canvas.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
